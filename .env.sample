# ==============================
# Variáveis do Banco de Dados (Postgres)
# ==============================
POSTGRES_USER=expenses_user
POSTGRES_PASSWORD=expenses_pass
POSTGRES_DB=expenses_db

# ==============================
# Variáveis do Backend (Server)
# ==============================
PORT=3333
DB_HOST=db
DB_USER=expenses_user
DB_PASS=expenses_pass
DB=expenses_db
# Lembre-se de ajustar a conexão no knexfile.js para não usar SSL localmente

# ==============================
# Variáveis do Frontend
# ==============================
# Nota: Para o frontend, as variáveis do Node.js não vão parar no código do browser.
# O porta onde o frontend vai rodar
PORT=3000
# Caso o seu server.js do frontend sirva de proxy (embora a implementação atual falhe no navegador)
API_URL=http://localhost:3333
